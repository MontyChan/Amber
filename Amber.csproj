  <Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Amber</AssemblyName>
    <RootNamespace>Amber</RootNamespace>
    <SpaRoot>Client\</SpaRoot>
    
    <ApplicationIcon Condition="Exists('Amber.ico')">Amber.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="BuildAmberClient" BeforeTargets="Build" Condition="Exists('Client\package.json')">
    <Exec WorkingDirectory="Client" Command="bun install --frozen-lockfile" />
    <Exec WorkingDirectory="Client" Command="bun run build" />
  </Target>

  <Target Name="CopyClientDist" AfterTargets="Build" Condition="Exists('Client\dist')">
    <ItemGroup>
      <ClientDistFiles Include="Client\dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientDistFiles)" DestinationFiles="@(ClientDistFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyClientDistToPublish" AfterTargets="Publish" Condition="Exists('Client\dist')">
    <ItemGroup>
      <ClientDistFiles Include="Client\dist\**" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientDistFiles)" DestinationFiles="@(ClientDistFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

</Project>
